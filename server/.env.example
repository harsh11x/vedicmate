# Copy to .env and fill in your values

# Local AI - ngrok URL to your LM Studio / local AI (change when ngrok restarts)
# Example: https://abc123.ngrok-free.app/v1
AI_NGROK_URL=https://your-ngrok-id.ngrok-free.app/v1

# Razorpay (optional)
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Gemini (optional - not used if you use local AI only)
GEMINI_API_KEY=your_gemini_key
