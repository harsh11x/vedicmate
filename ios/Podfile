# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  # Suppress warnings from third-party pods (Firebase, AppAuth, gRPC, etc.)
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # WebRTC xcframework: required for device builds with flutter_webrtc
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      # Suppress warnings from third-party pods (C/ObjC)
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      # Generate dSYM for Release/Profile to fix "Upload Symbols Failed" warnings
      if config.name == 'Release' || config.name == 'Profile'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'YES'
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'YES'
        config.build_settings['COPY_PHASE_STRIP'] = 'YES'
      end
    end
  end

  # Patch Pods-Runner-frameworks.sh to install dSYMs from xcframeworks (fixes "Upload Symbols Failed")
  frameworks_script = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner', 'Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_script)
    script_content = File.read(frameworks_script)
    script_content.gsub!(
      /\n# Install dSYMs for XCFrameworks \(fixes Upload Symbols Failed warnings\).*?\nfi\n\n/m,
      "\n"
    )

    dsym_block = "\n# Install dSYMs for XCFrameworks (fixes Upload Symbols Failed warnings)\n"
    dsym_block += "if [[ \"\$CONFIGURATION\" == \"Release\" ]] || [[ \"\$CONFIGURATION\" == \"Profile\" ]]; then\n"
    dsym_block += "  for DSYM_SRC in \\\n"
    dsym_block += "    \"\${PODS_ROOT}/WebRTC-SDK/WebRTC.xcframework/ios-arm64/dSYMs/WebRTC.framework.dSYM\" \\\n"
    dsym_block += "    \"\${PODS_ROOT}/razorpay-core-pod/Pod/core/Razorpay.xcframework/ios-arm64/dSYMs/Razorpay.framework.dSYM\" \\\n"
    dsym_block += "    \"\${PODS_ROOT}/razorpay-core-pod/Pod/core/RazorpayCore.xcframework/ios-arm64/dSYMs/RazorpayCore.framework.dSYM\" \\\n"
    dsym_block += "    \"\${PODS_ROOT}/razorpay-pod/Pod/RazorpayStandard.xcframework/ios-arm64/dSYMs/RazorpayStandard.framework.dSYM\"; do\n"
    dsym_block += "    [[ -r \"\$DSYM_SRC\" ]] && install_dsym \"\$DSYM_SRC\"\n"
    dsym_block += "  done\n"
    dsym_block += "\n"
    dsym_block += "  WEBRTC_BINARY=\"\${PODS_ROOT}/WebRTC-SDK/WebRTC.xcframework/ios-arm64/WebRTC.framework/WebRTC\"\n"
    dsym_block += "  WEBRTC_DSYM=\"\${TARGET_TEMP_DIR}/GeneratedWebRTCDSYMs/WebRTC.framework.dSYM\"\n"
    dsym_block += "  if [[ -r \"\$WEBRTC_BINARY\" && ! -r \"\${PODS_ROOT}/WebRTC-SDK/WebRTC.xcframework/ios-arm64/dSYMs/WebRTC.framework.dSYM\" ]]; then\n"
    dsym_block += "    rm -rf \"\$WEBRTC_DSYM\"\n"
    dsym_block += "    mkdir -p \"$(dirname \"\$WEBRTC_DSYM\")\"\n"
    dsym_block += "    dsymutil \"\$WEBRTC_BINARY\" -o \"\$WEBRTC_DSYM\" || true\n"
    dsym_block += "    [[ -r \"\$WEBRTC_DSYM\" ]] && install_dsym \"\$WEBRTC_DSYM\"\n"
    dsym_block += "  fi\n"
    dsym_block += "fi\n\n"

    target_block_regex = /if \[ "\$\{COCOAPODS_PARALLEL_CODE_SIGN\}" == "true" \]; then\n  wait\nfi\s*\z/m
    if script_content.match?(target_block_regex)
      script_content.sub!(target_block_regex) { |m| "#{dsym_block}#{m}" }
      File.write(frameworks_script, script_content)
    end
  end
end
