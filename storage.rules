rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reels/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Profile photos — authenticated users (including anonymous/guest sign-in)
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName.matches('.*' + request.auth.uid + '.*');
      allow delete: if request.auth != null
        && fileName.matches('.*' + request.auth.uid + '.*');
    }
  }
}
